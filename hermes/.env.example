# Copy these values into your shell before running ./install.sh.
# Never commit real values.
HERMES_TELEGRAM_BOT_TOKEN=<set-in-environment>
HERMES_TELEGRAM_ALLOWED_USERS=<comma-separated-telegram-user-ids>

# Optional: register exactly one local Sanbi project during installation.
HERMES_SANBI_PROJECT_ALIAS=<alias>
HERMES_SANBI_PROJECT_PATH=C:/absolute/path/to/project

# Optional and deliberately off by default. When set to 1, the installer may
# install/start or restart the gateway, then verify it with a deep status check.
HERMES_GATEWAY_MANAGE=0
